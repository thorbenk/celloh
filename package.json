{
  "name": "celloh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "audio:fetch": "python3 scripts/fetch-audio.py",
    "audio:verify": "python3 scripts/fetch-audio.py --verify",
    "build:deploy": "npm run audio:fetch && npm run check && npm run build",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "deploy:check": "wrangler deploy --dry-run",
    "test:audio": "python3 -B -m unittest discover -s tests -p '*_test.py'",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.1.0",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
