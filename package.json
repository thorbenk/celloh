{
  "name": "celloh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:portal": "vite --host 0.0.0.0 --experimental-bundle",
    "storybook": "storybook dev --host 0.0.0.0 --no-open --disable-telemetry",
    "build:storybook": "storybook build --disable-telemetry",
    "test:stories": "npm run build:storybook && playwright test --config playwright.storybook.config.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "audio:fetch": "python3 scripts/fetch-audio.py",
    "audio:verify": "python3 scripts/fetch-audio.py --verify",
    "build:deploy": "npm run audio:fetch && npm run check && npm run build",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "deploy:check": "wrangler deploy --dry-run",
    "test:audio": "python3 -B -m unittest discover -s tests -p '*_test.py'",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "audio:soundfont": "python3 scripts/fetch-soundfont.py",
    "predev": "npm run audio:soundfont",
    "prebuild": "npm run audio:soundfont"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/html-vite": "^10.6.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "storybook": "^10.6.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "driver.js": "^1.9.0",
    "pitchy": "^4.1.0",
    "spessasynth_lib": "4.3.14",
    "vexflow": "^4.2.5"
  }
}
