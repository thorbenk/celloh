#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
started=$SECONDS

echo "Checking the orb's Node.js, npm, and Python toolchain..."
node -e '
  const [major, minor] = process.versions.node.split(".").map(Number);
  if (major < 22 || (major === 22 && minor < 13)) {
    throw new Error("CellOh! requires Node.js 22.13+ (provided by the orb base image).");
  }
'
npm --version
python3 --version

echo "Installing dependencies from package-lock.json..."
time npm ci --no-audit --no-fund

echo "Installing the lockfile-matched Playwright Chromium browser..."
system_dependencies=$(npx playwright install-deps --dry-run chromium)
echo "$system_dependencies"
if [[ "$system_dependencies" != "All system dependencies are installed." ]]; then
  time npx playwright install-deps chromium
fi
time npx playwright install chromium

echo "Preparing the published cello recordings..."
audio_config="$HOME/.cache/celloh/audio-release.json"
if cmp -s audio-release.json "$audio_config" && npm run audio:verify; then
  echo "Reusing the verified audio release."
else
  time npm run audio:fetch
  mkdir -p "$(dirname "$audio_config")"
  cp audio-release.json "$audio_config"
fi

echo "Orb setup finished in $((SECONDS - started)) seconds."
